# Where the SQLite database lives. Committed-free: see .gitignore.
DATABASE_PATH=data/prospects.db

LOG_LEVEL=info

# Contact address advertised in the crawler's User-Agent, so a site owner who
# sees the traffic has somewhere to complain. Set this before running anything
# against a real site — an anonymous crawler is the kind that gets blocked.
CRAWLER_CONTACT=

# Optional. Bandsintown and Songkick have official APIs; without a key the
# corresponding source adapter is skipped rather than scraped around.
BANDSINTOWN_APP_ID=
SONGKICK_API_KEY=
